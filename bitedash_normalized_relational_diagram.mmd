        int rating
        text comment
        datetime created_at
    }
    PROMOTIONS {
        bigint id PK
        bigint restaurant_id FK
        varchar code
        text description
        decimal discount_percent
        decimal discount_amount
        datetime valid_from
        datetime valid_until
        boolean is_active
    }

