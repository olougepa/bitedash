erDiagram
    USERS {
        bigint id PK
        varchar email
        varchar full_name
        varchar phone
        enum role
        enum status
        boolean location_enabled
        datetime created_at
    }
    ROLES {
        int id PK
        varchar name
        varchar description
    }
    RESTAURANTS {
        bigint id PK
        bigint owner_id FK
        varchar name
        text description
        bigint address_id FK
        enum status
        boolean is_open
        decimal latitude
        decimal longitude
    }
