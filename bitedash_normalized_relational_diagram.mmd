        bigint id PK
        bigint user_id FK
        bigint restaurant_id FK
        int party_size
        datetime reservation_time
        enum status
        text special_requests
    }
    PAYMENTS {
        bigint id PK
        bigint order_id FK
        bigint user_id FK
        bigint payment_method_id FK
        decimal amount
        varchar currency
        enum status
        varchar transaction_reference
